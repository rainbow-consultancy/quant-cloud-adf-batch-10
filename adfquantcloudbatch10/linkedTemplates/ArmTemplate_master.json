{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adfquantcloudbatch10"
		},
		"LS_ADLS_GEN2_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'LS_ADLS_GEN2'"
		},
		"LS_SQL_SERVER_ONPREM_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_SQL_SERVER_ONPREM'"
		},
		"LS_ADLS_GEN2_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://qcadlsbatch10.dfs.core.windows.net/"
		},
		"LS_AZURE_KEY_VAULT_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://qct-secret-store.vault.azure.net/"
		},
		"LS_AZURE_SQL_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "quantserver.database.windows.net"
		},
		"LS_AZURE_SQL_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "qct-batch-11"
		},
		"LS_AZURE_SQL_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "quant-user"
		},
		"LS_SQL_SERVER_ONPREM_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "SandeepReddy"
		},
		"LS_SQL_SERVER_ONPREM_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "qc_db_batch11"
		},
		"LS_SQL_SERVER_ONPREM_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "batch_10"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adfquantcloudbatch10_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"LS_ADLS_GEN2_accountKey": {
						"value": "[parameters('LS_ADLS_GEN2_accountKey')]"
					},
					"LS_SQL_SERVER_ONPREM_password": {
						"value": "[parameters('LS_SQL_SERVER_ONPREM_password')]"
					},
					"LS_ADLS_GEN2_properties_typeProperties_url": {
						"value": "[parameters('LS_ADLS_GEN2_properties_typeProperties_url')]"
					},
					"LS_AZURE_KEY_VAULT_properties_typeProperties_baseUrl": {
						"value": "[parameters('LS_AZURE_KEY_VAULT_properties_typeProperties_baseUrl')]"
					},
					"LS_AZURE_SQL_properties_typeProperties_server": {
						"value": "[parameters('LS_AZURE_SQL_properties_typeProperties_server')]"
					},
					"LS_AZURE_SQL_properties_typeProperties_database": {
						"value": "[parameters('LS_AZURE_SQL_properties_typeProperties_database')]"
					},
					"LS_AZURE_SQL_properties_typeProperties_userName": {
						"value": "[parameters('LS_AZURE_SQL_properties_typeProperties_userName')]"
					},
					"LS_SQL_SERVER_ONPREM_properties_typeProperties_server": {
						"value": "[parameters('LS_SQL_SERVER_ONPREM_properties_typeProperties_server')]"
					},
					"LS_SQL_SERVER_ONPREM_properties_typeProperties_database": {
						"value": "[parameters('LS_SQL_SERVER_ONPREM_properties_typeProperties_database')]"
					},
					"LS_SQL_SERVER_ONPREM_properties_typeProperties_userName": {
						"value": "[parameters('LS_SQL_SERVER_ONPREM_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "adfquantcloudbatch10_ArmTemplate_1",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_1.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					}
				}
			},
			"dependsOn": [
				"[resourceId('Microsoft.Resources/deployments', 'adfquantcloudbatch10_ArmTemplate_0')]"
			]
		}
	]
}