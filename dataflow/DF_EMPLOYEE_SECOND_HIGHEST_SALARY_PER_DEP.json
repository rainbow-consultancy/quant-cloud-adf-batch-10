{
	"name": "DF_EMPLOYEE_SECOND_HIGHEST_SALARY_PER_DEP",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_DF_EMPLOYEE_CSV_SOURCE",
						"type": "DatasetReference"
					},
					"name": "EMPSOURCE"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_DF_SINK_EMPLOYEE",
						"type": "DatasetReference"
					},
					"name": "sink"
				}
			],
			"transformations": [
				{
					"name": "SECONDHIGHESTSALARY"
				},
				{
					"name": "filter1"
				},
				{
					"name": "select1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          EMP_ID as integer,",
				"          NAME as string,",
				"          DEP_ID as integer,",
				"          SALARY as integer,",
				"          ACTIVE_STATUS as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> EMPSOURCE",
				"EMPSOURCE window(over(DEP_ID),",
				"     desc(SALARY, true),",
				"     rn = rowNumber()) ~> SECONDHIGHESTSALARY",
				"SECONDHIGHESTSALARY filter(toInteger(byName('rn')) == 2,",
				"     partitionBy('hash', 1)) ~> filter1",
				"filter1 select(mapColumn(",
				"          EMP_ID,",
				"          NAME,",
				"          DEP_ID,",
				"          SALARY,",
				"          ACTIVE_STATUS",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"select1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     partitionFileNames:['filtered_employee_highest_salary'],",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> sink"
			]
		}
	}
}